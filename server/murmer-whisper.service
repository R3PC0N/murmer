[Unit]
Description=Murmer Whisper Transcription Server
After=network.target

[Service]
Type=simple
User=r3pc0n
WorkingDirectory=/opt/murmer-server
EnvironmentFile=/opt/murmer-server/.env
ExecStart=/opt/murmer-server/venv/bin/python faster_whisper_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
